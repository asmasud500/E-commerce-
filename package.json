{
  "name": "e-commerce-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "cf:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare preview",
    "db:migrate-firestore": "node --experimental-strip-types scripts/migrate-postgres-to-firestore.ts",
    "test:security": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:seed-demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/seed-demo-products.ts"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@prisma/client": "^6.16.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.16.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.125.0"
  }
}
