FIREBASE_PROJECT_ID="your-firestore-project-id"
FIREBASE_CLIENT_EMAIL="your-firestore-service-account@example.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
# Firebase service-account values are for the existing Firestore backend only; file storage uses Telegram.
FIREBASE_PROJECT_ID="e-commerce-bb2af"
# Firebase Console > Storage > Files: copy the exact bucket name (often PROJECT_ID.firebasestorage.app)
FIREBASE_STORAGE_BUCKET="e-commerce-bb2af.firebasestorage.app"
FIREBASE_CLIENT_EMAIL="firebase-service-account@example.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
# Optional: only required for PostgreSQL-to-Firestore migration
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
PAYMENT_ENCRYPTION_KEY="replace-with-a-long-random-secret"
# Canonical public HTTPS URL used for payment-provider callbacks (required in production)
PAYMENT_CALLBACK_BASE_URL="https://your-store.example"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
 # Telegram file storage: use a private admin chat; never commit real credentials.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ADMIN_USER_IDS=""
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-secret"
PAYMENT_WEBHOOK_SECRET="replace-with-a-random-secret"
MOBILE_MONEY_SMS_WEBHOOK_SECRET="replace-with-a-random-secret"
CRON_SECRET="replace-with-a-random-secret"
